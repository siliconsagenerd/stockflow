{
  "name": "stockflow-ai-purchasing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI purchasing approval sidecar: Node/Express service that scores pending purchase requests and a React console for the reviewer.",
  "scripts": {
    "dev:api": "tsx watch src/server.ts",
    "dev:web": "vite",
    "build": "npm run build:web && npm run build:api",
    "build:web": "vite build",
    "build:api": "tsc -p tsconfig.api.json",
    "start": "node dist/api/server.js",
    "demo": "DEMO_MODE=1 npm run start",
    "typecheck": "tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.api.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "express": "^5.1.0",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.8",
    "@tailwindcss/vite": "^4.1.13",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "playwright-core": "^1.56.0",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  }
}
